Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe])' /></column><column caption='Pengaruh Arah Angin' datatype='string' name='[Calculation_aa002]' role='measure' type='nominal'><calculation class='tableau' formula='STR(SUM(IF [sector_ratio] &gt;= 1.1 THEN 1 ELSE 0 END)) + &quot; / &quot; + STR(COUNT([sector_ratio]))' /></column><column-instance column='[selisih_pct]' derivation='Avg' name='[avg:selisih_pct:qk]' pivot='key' type='quantitative' /><column-instance column='[Calculation_aa001]' derivation='None' name='[none:Calculation_aa001:nk]' pivot='key' type='nominal' /><column-instance column='[stasiun]' derivation='None' name='[none:stasiun:nk]' pivot='key' type='nominal' /><column-instance column='[tipe_lokasi]' derivation='None' name='[none:tipe_lokasi:nk]' pivot='key' type='nominal' /></datasource-dependencies><computed-sort column='[federated.aa].[none:stasiun:nk]' direction='DESC' using='[federated.aa].[avg:selisih_pct:qk]' /><filter class='categorical' column='[federated.aa].[none:Calculation_aa001:nk]'><groupfilter function='member' level='[none:Calculation_aa001:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.aa].[none:Calculation_aa001:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='mark'><encoding attr='color' field='[federated.aa].[none:tipe_lokasi:nk]' type='palette'><map to='#2a78d6'><bucket>&quot;Perkotaan&quot;</bucket></map><map to='#eb6834'><bucket>&quot;Tepi jalan&quot;</bucket></map><map to='#1baf7a'><bucket>&quot;Industri&quot;</bucket></map><map to='#eda100'><bucket>&quot;Gambut / karhutla&quot;</bucket></map><map to='#e87ba4'><bucket>&quot;Latar bersih&quot;</bucket></map></encoding></style-rule><style-rule element='axis'><format attr='title' class='0' field='[federated.aa].[avg:selisih_pct:qk]' scope='cols' value='PM2.5 arah terkotor dibanding