me='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column datatype='real' name='[total_cases]' role='measure' type='quantitative' /><column caption='Kasus Akibat PM2.5' datatype='real' default-format='n#,##0' name='[attributable]' role='measure' type='quantitative' /><column datatype='real' name='[attributable_pct]' role='measure' type='quantitative' /><column datatype='string' name='[outcome]' role='dimension' type='nominal' /><column caption='Jenis Kasus' datatype='string' name='[kasus]' role='dimension' type='nominal' /><column caption='Filter Atribusi' datatype='boolean' name='[Calculation_at001]' role='dimension' type='nominal'><calculation class='tableau' formula='[kasus] = [Parameters].[p_kasus] AND [pulau] &lt;&gt; &quot;Total&quot; AND ([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau])' /></column><column caption='Filter Atribusi Total' datatype='boolean' name='[Calculation_at002]' role='dimension' type='nominal'><calculation class='tableau' formula='[kasus] = [Parameters].[p_kasus] AND [pulau] = &quot;Total&quot;' /></column></datasource><datasource caption='Celah Jaringan' inline='true' name='federated.ce' version='18.1'><connection class='federated'><named-connections><named-connection caption='Celah Jaringan' name='hyper.ce'><connection authentication='auth-none' author-locale='en_US' class='hyper' dbname='Data/Extracts/celah.hyper' default-settings='yes' port='' sslmode='' username='tableau_internal_user' /></named-connection></named-connections><relation connection='hyper.ce' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column datatype='string' name='[station_a]' role='dimension' type='nominal' /><column datatype='string' name='[station_b]' ro