ole='dimension' type='nominal' /><column caption='Kota/Kabupaten' datatype='string' name='[kota]' role='dimension' type='nominal' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' role='dimension' type='nominal' /><column datatype='integer' name='[dipakai]' role='dimension' type='ordinal' /><column caption='Tanggal' datatype='date' name='[tanggal]' role='dimension' type='ordinal' /><column caption='Tahun' datatype='integer' name='[tahun]' role='dimension' type='ordinal' /><column caption='Bulan' datatype='integer' name='[bulan]' role='dimension' type='ordinal'><aliases><alias key='1' value='Jan' /><alias key='2' value='Feb' /><alias key='3' value='Mar' /><alias key='4' value='Apr' /><alias key='5' value='Mei' /><alias key='6' value='Jun' /><alias key='7' value='Jul' /><alias key='8' value='Agu' /><alias key='9' value='Sep' /><alias key='10' value='Okt' /><alias key='11' value='Nov' /><alias key='12' value='Des' /></aliases></column><column caption='Musim' datatype='string' name='[musim]' role='dimension' type='nominal' /><column datatype='integer' name='[kabut_asap]' role='dimension' type='ordinal' /><column caption='PM2.5' datatype='real' default-format='n#,##0.0' name='[pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_balita]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_lansia]' role='measure' type='quantitative' /><column datatype='integer' name='[darurat_asma]' role='measure' type='quantitative' /><column datatype='integer' name='[ppok]' role='measure' type='quantitative' /><column datatype='integer' name='[pernapasan_umum]' role='measure' type='quantitative' /><column datatype='integer' name='[kardiovaskular]' role='measure' type='quantitative' /><column datatype='integer' name='[kematian]' role='measure' type='quantitative' /><column datatype='real' name='[ispa_balita_7h]' role='measure' type='quantitative' /><column datatype='real' name='[ispa_lansia_7h]' role='measure' type='quantitative' /><column datatype='real' name='[darurat_asma_7h]' role='measure' type='quantitative' /><column datatype='real' name='[ppok_7h]' role='measure' type='quantitative' /><column datatype='real' name='[pernapasan_umum_7h]' role='measure' type='quantitative' /><column datatype='real' name='[kardiovaskular_7h]' role='measure' type='quantitative' /><column datatype='real' name='[kematian_7h]' role='measure' type='quantitative' /><column caption='Filter Rumah Sakit' datatype='boolean' name='[Calculation_rs001]' role='dimension' type='nominal'><calculation class='tableau' formula='([rumah_sakit] + &quot; (&quot; + [stasiun] + &quot;)&quot;) = [Parameters].[p_rs] AND ([Parameters].[p_musim] = &quot;Semua musim&quot; OR ([Parameters].[p_musim] = &quot;Hujan (Nov–Apr)&quot; AND ([bulan] &gt;= 11 OR [bulan] &lt;= 4)) OR ([Parameters].[p_musim] = &quot;Kemarau (Mei–Okt)&quot; AND [bulan] &gt;= 5 AND [bulan] &lt;= 10) OR ([Parameters].[p_musim] = &quot;Puncak kabut (Agu–Okt)&quot; AND [bulan] &gt;= 8 AND [bulan] &lt;= 10)) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun])' /></column><column caption='Kasus Harian' datatype='real' default-format='n#,##0' name='[Calculation_rs002]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_kasus] WHEN &quot;ISPA balita&quot; THEN [ispa_balita] WHEN &quot;ISPA lansia&quot; THEN [ispa_lansia] WHEN &quot;Darurat asma&quot; THEN [darurat_asma] WHEN &quot;PPOK&quot; THEN [ppok] WHEN &quot;Pernapasan umum&quot; THEN [pernapasan_umum] WHEN &quot;Kardiovaskular&quot; THEN [kardiovaskular] WHEN &quot;Kematian&quot; THEN [kematian] END' /></column><column caption='Kasus Rata-Rata 7 Hari' datatype='real' default-format='n#,##0.0' name='[Calculation_rs003]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_kasus] WHE