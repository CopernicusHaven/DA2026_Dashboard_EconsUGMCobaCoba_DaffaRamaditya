nal' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' role='dimension' type='nominal' /><column caption='Lintang' datatype='real' name='[lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' /><column caption='Bujur' datatype='real' name='[lon]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' /><column datatype='integer' name='[dipakai]' role='dimension' type='ordinal' /><column datatype='string' name='[nama_sensor]' role='dimension' type='nominal' /><column datatype='string' name='[karakteristik_wilayah]' role='dimension' type='nominal' /><column datatype='real' name='[lalu_lintas_per_jam]' role='measure' type='quantitative' /><column datatype='real' name='[jarak_jalan_m]' role='measure' type='quantitative' /><column datatype='real' name='[kelengkapan_pm25_pct]' role='measure' type='quantitative' /><column caption='Keandalan Alat' datatype='string' name='[keandalan]' role='dimension' type='nominal' /><column datatype='string' name='[aksi_alat]' role='dimension' type='nominal' /><column caption='Skor Prioritas' datatype='real' default-format='n#,##0.0' name='[skor_prioritas]' role='measure' type='quantitative' /><column datatype='string' name='[stasiun_terdekat]' role='dimension' type='nominal' /><column datatype='real' name='[jarak_terdekat_km]' role='measure' type='quantitative' /><column caption='Tren 2024 ke 2026' datatype='string' name='[tren]' role='dimension' type='nominal' /><column datatype='real' name='[perubahan_2024_2026_pct]' role='measure' type='quantitative' /><column caption='2024' datatype='real' name='[pm25_2024]' role='measure' type='quantitative' /><column caption='2025' datatype='real' name='[pm25_2025]' role='measure' type='quantitative' /><column caption='2026' datatype='real' name='[pm25_2026]' role='measure' type='quantitative' /><column caption='Rumah Sakit' datatype='string' name='[rumah_sakit]' role='dimension' type='nominal' /><column caption='Nama Rumah Sak