]' param-domain-type='any' role='measure' type='quantitative' value='55.0'><calculation class='tableau' formula='55.0' /></column><column caption='Risiko Relatif 1' datatype='real' name='[p_rr1]' param-domain-type='any' role='measure' type='quantitative' value='1.0'><calculation class='tableau' formula='1.0' /></column></datasource-dependencies><datasource-dependencies datasource='federated.st'><column caption='Stasiun' datatype='string' name='[stasiun]' role='dimension' type='nominal' /><column caption='Kota/Kabupaten' datatype='string' name='[kota]' role='dimension' type='nominal' /><column caption='Provinsi' datatype='string' name='[provinsi]' role='dimension' type='nominal' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' role='dimension' type='nominal' /><column caption='Lintang' datatype='real' name='[lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' /><column caption='Bujur' datatype='real' name='[lon]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' /><column datatype='integer' name='[dipakai]' role='dimension' type='ordinal' /><column datatype='string' name='[nama_sensor]' role='dimension' type='nominal' /><column datatype='string' name='[karakteristik_wilayah]' role='dimension' type='nominal' /><column datatype='real' name='[lalu_lintas_per_jam]' role='measure' type='quantitative' /><column datatype='real' name='[jarak_jalan_m]' role='measure' type='quantitative' /><column datatype='real' name='[kelengkapan_pm25_pct]' role='measure' type='quantitative' /><column caption='Keandalan Alat' datatype='string' name='[keandalan]' role='dimension' type='nominal' /><column datatype='string' name='[aksi_alat]' role='dimension' type='nominal' /><column caption='Skor Prioritas' datatype='real' default-format='n#,##0.0' name='[skor_prioritas]' role='measure' type='quantitative' /><column datatype='string' name='[stasiun_terdekat]' role='dimension' type='nominal' /><column datatype='real' name='[jarak_terdekat_km]' role='measure' type='quantitative' /><column caption='Tren 2024 ke 2026' datatype='string' name='[tren]' role='dimension' type='nominal' /><column datatype='real' name='[perubahan_2024_2026_pct]' role='measure' type='quantitative' /><column caption='2024' datatype='real' name='[pm25_2024]' role='measure' type='quantitative' /><column caption='2025' datatype='real' name='[pm25_2025]' role='measure' type='quantitative' /><column caption='2026' datatype='real' name='[pm25_2026]' role='measure' type='quantitative' /><column caption='Rumah Sakit' datatype='string' name='[rumah_sakit]' role='dimension' type='nominal' /><column caption='Nama Rumah Sakit' datatype='string' name='[nama_rumah_sakit]' role='dimension' type='nominal' /><column caption='Filter Stasiun' datatype='boolean' name='[Calculation_st001]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND [dipakai] = 1' /></column><column caption='Filter Jaringan' datatype='boolean' name='[Calculation_st002]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe])' /></column><column caption='Stasiun Memburuk' datatype='string' name='[Calculation_st003]' role='measure' type='nominal'><calculation class='tableau' formula='STR(SUM(IF [tren] = &quot;Memburuk&quot; THEN 1 ELSE 0 END)) + &quot; / &quot; + STR(COUNT([stasiun]))' /></column><column caption='Stasiun Andal' datatype='string' name='[Calculation_st004]' role='measure' type='nominal'><calculation class='tableau' formula='STR(SUM(IF [keandalan] = &quot;Baik&quot; THEN 1 ELSE 0 END)) + &quot; / &quot; + STR(COUNT([stasiun]))' /></column><column caption='Prioritas Utama' datatype='string' name='[Calculation_st005]' role='measure' type='nominal'><calculation class='tableau' formula='MID(MAX(STR(INT(100000 + ROUND([skor_prioritas] * 100, 0))) + [stasiun]), 7)' /></column><column-instance column='[lat]' derivation='Avg' name='[avg:lat:qk]' pivot='key' type='quantitative' /><column-instance column='[lon]' derivation='Avg' name='[avg:lon:qk]' pivot='key' type='quantitative' /><column-instance column='[Calculation_st002]' derivation='None' name='[none:Calculation_st002:nk]' pivot='key' type='nominal' /><column-instance column='[keandalan]' derivation='None' name='[none:keandalan:nk]' pivot='key' type='nominal' /><column-instance column='[kota]' derivation='None' name='[none:kota:nk]' pivot='key' type='nominal' /><column-instance column='[stasiun]' derivation='None' name='[none:stasiun:nk]' pivot='key' type='nominal' /></datasource-dependencies><filter class='categorical' column='[federated.st].[none:Calculation_st002:nk]'><groupfilter function='member' level='[none:Calculation_st002:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.st].[none:Calculation_st002:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='mark'><encoding attr='color' field='[federated.st].[none:keandalan:nk]' type='palette'><map to='#2a78d6'><bucket>&quot;Baik&quot;</bucket></map><map to='#eda100'><bucket>&quot;Perlu standardisasi&quot;</bucket></map><map to='#eb6834'><bucket>&quot;Buruk - perlu kalibrasi/perawatan&quot;</bucket></map><map to='#d03b3b'><bucket>&quot;Kritis - ganti/perbaiki&quot;</bucket></map></encoding></style-rule><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule><style-rule e