2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /></members></column><column caption='Tahun Baku Mutu' datatype='string' name='[p_thbm]' param-domain-type='list' role='measure' type='nominal' value='&quot;2025&quot;'><calculation class='tableau' formula='&quot;2025&quot;' /><members><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Jenis Kasus' datatype='string' name='[p_kasus]' param-domain-type='list' role='measure' type='nominal' value='&quot;ISPA balita&quot;'><calculation class='tableau' formula='&quot;ISPA balita&quot;' /><members><member value='&quot;ISPA balita&quot;' /><member value='&quot;ISPA lansia&quot;' /><member value='&quot;Darurat asma&quot;' /><member value='&quot;PPOK&quot;' /><member value='&quot;Pernapasan umum&quot;' /><member value='&quot;Kardiovaskular&quot;' /><member value='&quot;Kematian&quot;' /></members></column><column caption='Rumah Sakit' datatype='string' name='[p_rs]' param-domain-type='list' role='measure' type='nominal' value='&quot;RS-XXX-04 (KTG-01)&quot;'><calculation class='tableau' formula='&quot;RS-XXX-04 (KTG-01)&quot;' /><members><member value='&quot;RS-XXX-01 (JKT-01)&quot;' /><member value='&quot;RS-XXX-02 (JKT-02)&quot;' /><member value='&quot;RS-XXX-03 (JKT-03)&quot;' /><member value='&quot;RS-XXX-04 (KTG-01)&quot;' /><member value='&quot;RS-XXX-05 (KTG-02)&quot;' /><member value='&quot;RS-XXX-06 (BGR-01)&quot;' /><member value='&quot;RS-XXX-07 (BGR-02)&quot;' /><member value='&quot;RS-XXX-08 (YKY-01)&quot;' /><member value='&quot;RS-XXX-09 (IDP-01)&quot;' /><member value='&quot;RS-XXX-10 (KTB-01)&quot;' /><member value='&quot;RS-XXX-11 (PKU-01)&quot;' /><member value='&quot;RS-XXX-12 (JMB-01)&quot;' /><member value='&quot;RS-XXX-13 (BTM-01)&quot;' /><member value='&quot;RS-XXX-14 (BGL-01)&quot;' /><member value='&quot;RS-XXX-15 (SRG-01)&quot;' /><member value='&quot;RS-XXX-16 (MLG-01)&quot;' /><member value='&quot;RS-XXX-17 (MRS-01)&quot;' /><member value='&quot;RS-XXX-18 (PLU-01)&quot;' /><member value='&quot;RS-XXX-19 (STG-01)&quot;' /><member value='&quot;RS-XXX-20 (PKN-01)&quot;' /><member value='&quot;RS-XXX-21 (PLB-01)&quot;' /><member value='&quot;RS-XXX-22 (PSW-01)&quot;' /><member value='&quot;RS-XXX-23 (MER-01)&quot;' /><member value='&quot;RS-XXX-24 (MDN-01)&quot;' /><member value='&quot;RS-XXX-25 (SM2-01)&quot;' /><member value='&quot;RS-XXX-26 (BJB-01)&quot;' /><member value='&quot;RS-XXX-27 (JMB-02)&quot;' /></members></column><column caption='Baku Mutu Tahunan PM2.5' datatype='real' name='[p_bm15]' param-domain-type='any' role='measure' type='quantitative' value='15.0'><calculation class='tableau' formula='15.0' /></column><column caption='Baku Mutu 24 Jam PM2.5' datatype='real' name='[p_bm55]' param-domain-type='any' role='measure' type='quantitative' value='55.0'><calculation class='tableau' formula='55.0' /></column><column caption='Risiko Relatif 1' datatype='real' name='[p_rr1]' param-domain-type='any' role='measure' type='quantitative' value='1.0'><calculation class='tableau' formula='1.0' /></column></datasource-dependencies><datasource-dependencies datasource='federated.sb'><column caption='Stasiun' datatype='string' name='[stasiun]' role='dimension' type='nominal' /><column caption='Kota/Kabupaten' datatype='string' name='[kota]' role='dimension' type='nominal' /><column caption='Provinsi' datatype='string' name='[provinsi]' role='dimension' type='nominal' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' role='dimension' type='nominal' /><column caption='Lintang' datatype='real' name='[lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' /><column caption='Bujur' datatype='real' name='[lon]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' /><column datatype='integer' name='[dipakai]' role='dimension' type='ordinal' /><column caption='Rumah Sakit' datatype='string' name='[rumah_sakit]' role='dimension' type='nominal' /><column caption='Tahun' datatype='integer' name='[tahun]' role='dimension' type='ordinal' /><column caption='Bulan' datatype='integer' name='[bulan]' role='dimension' type='ordinal'><aliases><alias key='1' value='Jan' /><alias key='2' value='Feb' /><alias key='3' value='Mar' /><alias key='4' value='Apr' /><alias key='5' value='Mei' /><alias key='6' value='Jun' /><alias key='7' value='Jul' /><alias key='8' value='Agu' /><alias key='9' value='Sep' /><alias key='10' value='Okt' /><alias key='11' value='Nov' /><alias key='12' value='Des' /></aliases></column><column datatype='string' name='[nama_bulan]' role='dimension' type='nominal' /><column caption='Periode' datatype='date' name='[periode]' role='dimension' type='ordinal' /><column caption='Musim' datatype='string' name='[musim]' role='dimension' type='nominal' /><column datatype='integer' name='[puncak_kabut]' role='dimension' type='ordinal' /><column datatype='real' name='[hs_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_pm25]' role='measure' type='quantitative' /><column datatype='real' name='[ds_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_pm25]' role='measure' type='quantitative' /><column datatype='real' name='[hs_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_pm10]' role='measure' type='quantitative' /><column datatype='real' name='[ds_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_pm10]' role='measure' type='quantitative' /><column datatype='real' name='[hs_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_so2]' role='measure' type='quantitative' /><column datatype='real' name='[ds_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_so2]' role='measure' type='quantitative' /><column datatype='real' name='[hs_co]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_co]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_co]' role='measure' type='quantitative' /><column datatype='real' name='[ds_co]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_co]' role='measure' type='quantitative' /><column datatype='real' name='[hs_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_o3]' role='measure' type='quantitative' /><column datatype='real' name='[ds_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_o3]' role='measure' type='quantitative' /><column datatype='real' name='[hs_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_no2]' role='measure' type='quantitative' /><column datatype='real' name='[ds_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_baik]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_sedang]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_tidak_sehat]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_sangat_tidak_sehat]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_berbahaya]' role='measure' type='quantitative' /><column caption='Hari Kabut' datatype='integer' default-format='n#,##0' name='[hari_kabut_asap]' role='measure' type='quantitative' /><column datatype='real' name='[pm25_harian_maks]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_rs]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_balita]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_lansia]' role='measure' type='quantitative' /><column datatype='integer' name='[darurat_asma]' role='measure' type='quantitative' /><column datatype='integer' name='[ppok]' role='measure' type='quantitative' /><column datatype='integer' name='[pernapasan_umum]' role='measure' type='quantitative' /><column datatype='integer' name='[kardiovaskular]' role='measure' type='quantitative' /><column datatype='integer' name='[kematian]' role='measure' type='quantitative' /><column caption='Filter Udara' datatype='boolean' name='[Calculation_sb001]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND ([Parameters].[p_musim] = &quot;Semua musim&quot; OR ([Parameters].[p_musim] = &quot;Hujan (Nov–Apr)&quot; AND ([bulan] &gt;= 11 OR [bulan] &lt;= 4)) OR ([Parameters].[p_musim] = &quot;Kemarau (Mei–Okt)&quot; AND [bulan] &gt;= 5 AND [bulan] &lt;= 10) OR ([Parameters].[p_musim] = &quot;Puncak kabut (Agu–Okt)&quot; AND [bulan] &gt;= 8 AND [bulan] &lt;= 10)) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun]) AND [dipakai] = 1' /></column><column caption='Filter Semua RS' datatype='boolean' name='[Calculation_sb002]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND ([Parameters].[p_musim] = &quot;Semua musim&quot; OR ([Parameters].[p_musim] = &quot;Hujan (Nov–Apr)&quot; AND ([bulan] &gt;= 11 OR [bulan] &lt;= 4)) OR ([Parameters].[p_musim] = &quot;Kemarau (Mei–Okt)&quot; AND [bulan] &gt;= 5 AND [bulan] &lt;= 10) OR ([Parameters].[p_musim] = &quot;Puncak kabut (Agu–Okt)&quot; AND [bulan] &gt;= 8 AND [bulan] &lt;= 10)) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun])' /></column><column caption='PM2.5 Rata-Rata Stasiun' datatype='real' default-format='n#,##0.0' name='[Calculation_sb003]' role='measure' type='quantitative'><calculation class='tableau' formula='{INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END}' /></column><column caption='PM2.5 Rata-Rata' datatype='real' default-format='n#,##0.0' name='[Calculation_sb004]' role='measure' type='quantitative'><calculation class='tableau' formula='IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END' /></column><column caption='Kategori PM2.5' datatype='string' name='[Calculation_sb005]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([Calculation_sb004]) THEN NULL ELSEIF [Calculation_sb004] &lt;= 15.5 THEN &quot;Baik&quot; ELSEIF [Calculation_sb004] &lt;= 55.4 THEN &quot;Sedang&quot; ELSEIF [Calculation_sb004] &lt;= 150.4 THEN &quot;Tidak Sehat&quot; ELSEIF [Calculation_sb004] &lt;= 250.4 THEN &quot;Sangat Tidak Sehat&quot; ELSE &quot;Berbahaya&quot; END' /></column><column caption='Hari Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb006]' role='measure' type='quantitative'><calculation class='tableau' formula='(SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya])) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Baik' datatype='real' default-format='p0.0%' name='[Calculation_sb007]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_baik]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Sedang' datatype='real' default-format='p0.0%' name='[Calculation_sb008]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_sedang]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb009]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_tidak_sehat]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Sangat Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb010]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_sangat_tidak_sehat]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Berbahaya' datatype='real' default-format='p0.0%' name='[Calculation_sb011]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_berbahaya]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='hs Terpilih' datatype='real' name='[Calculation_sb012]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [hs_pm25] WHEN &quot;PM10&quot; THEN [hs_pm10] WHEN &quot;SO₂&quot; THEN [hs_so2] WHEN &quot;CO&quot; THEN [hs_co] WHEN &quot;O₃&quot; THEN [hs_o3] WHEN &quot;NO₂&quot; THEN [hs_no2] END' /></column><column caption='hn Terpilih' datatype='real' name='[Calculation_sb013]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [hn_pm25] WHEN &quot;PM10&quot; THEN [hn_pm10] WHEN &quot;SO₂&quot; THEN [hn_so2] WHEN &quot;CO&quot; THEN [hn_co] WHEN &quot;O₃&quot; THEN [hn_o3] WHEN &quot;NO₂&quot; THEN [hn_no2] END' /></column><column caption='vd Terpilih' datatype='real' name='[Calculation_sb014]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [vd_pm25] WHEN &quot;PM10&quot; THEN [vd_pm10] WHEN &quot;SO₂&quot; THEN [vd_so2] WHEN &quot;CO&quot; THEN [vd_co] WHEN &quot;O₃&quot; THEN [vd_o3] WHEN &quot;NO₂&quot; THEN [vd_no2] END' /></column><column caption='ds Terpilih' datatype='real' name='[Calculation_sb015]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [ds_pm25] WHEN &quot;PM10&quot; THEN [ds_pm10] WHEN &quot;SO₂&quot; THEN [ds_so2] WHEN &quot;CO&quot; THEN [ds_co] WHEN &quot;O₃&quot; THEN [ds_o3] WHEN &quot;NO₂&quot; THEN [ds_no2] END' /></column><column caption='dn Terpilih' datatype='real' name='[Calculation_sb016]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [dn_pm25] WHEN &quot;PM10&quot; THEN [dn_pm10] WHEN &quot;SO₂&quot; THEN [dn_so2] WHEN &quot;CO&quot; THEN [dn_co] WHEN &quot;O₃&quot; THEN [dn_o3] WHEN &quot;NO₂&quot; THEN [dn_no2] END' /></column><column caption='Rata-Rata Stasiun (Polutan Terpilih)' datatype='real' default-format='n#,##0.0' name='[Calculation_sb017]' role='measure' type='quantitative'><calculation class='tableau' formula='{INCLUDE [stasiun] : IF SUM([Calculation_sb014]) &gt;= 10 THEN SUM([Calculation_sb012]) / SUM([Calculation_sb013]) END}' /></column><column caption='Rata-Rata (Polutan Terpilih)' datatype='real' default-format='n#,##0.0' name='[Calculation_sb018]' role='measure' type='quantitative'><calculation class='tableau' formula='IF SUM([Calculation_sb014]) &gt;= 10 THEN SUM([Calculation_sb012]) / SUM([Calculation_sb013]) END' /></column><column caption='Rata-Rata Bulanan' datatype='real' default-format='n#,##0.0' name='[Calculation_sb019]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Calculation_sb015]) / SUM([Calculation_sb016])' /></column><column caption='Baku Mutu Tahunan' datatype='real' name='[Calculation_sb020]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 15 WHEN &quot;PM10&quot; THEN 40 WHEN &quot;SO₂&quot; THEN 45 WHEN &quot;NO₂&quot; THEN 50 WHEN &quot;O₃&quot; THEN 35 END' /></column><column caption='Pedoman WHO Tahunan' datatype='real' name='[Calculation_sb021]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 5 WHEN &quot;PM10&quot; THEN 15 WHEN &quot;NO₂&quot; THEN 10 END' /></column><column caption='Baku Mutu 24 Jam' datatype='real' name='[Calculation_sb022]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 55 WHEN &quot;PM10&quot; THEN 75 WHEN &quot;SO₂&quot; THEN 75 WHEN &quot;NO₂&quot; THEN 65 END' /></column><column caption='Melampaui Baku Mutu' datatype='string' name='[Calculation_sb023]' role='measure' type='nominal'><calculation class='tableau' formula='STR(SUM({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 AND SUM([hs_pm25]) / SUM([hn_pm25]) &gt; 15 THEN 1 ELSE 0 END})) + &quot; / &quot; + STR(SUM({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN 1 ELSE 0 END}))' /></column><column caption='Pulau Paling Tercemar' datatype='string' name='[Calculation_sb024]' role='measure' type='nominal'><calculation class='tableau' formula='MID(MAX({INCLUDE [pulau] : STR(INT(10000 + ROUND(AVG({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END}) * 10, 0))) + MIN([pulau])}), 6)' /></column><column-instance column='[Calculation_sb001]' derivation='None' name='[none:Calculation_sb001:nk]' pivot='key' type='nominal' /><column-instance column='[Calculation_sb023]' derivation='User' name='[usr:Calculation_sb023:nk]' pivot='key' type='nominal' /></datasource-dependencies><filter class='categorical' column='[federated.sb].[none:Calculation_sb001:nk]'><groupfilter function='member' level='[none:Calculation_sb001:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.sb].[none:Calculation_sb001:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule><style-rule element='all'><format attr='font-family' value='Helvetica Neue' /><format attr='color' value='#000000' /></style-rule><style-rule element='cell'><format attr='text-align' value='center' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.sb].[usr:Calculation_sb023:nk]' /></encodings><customized-label><formatted-text><run fontalignment='1' fontcolor='#000000' fontname='Helvetica Neue' fontsize='26'><![CDATA[<[federated.sb].[usr:Calculation_sb023:nk]>]]></run></formatted-text></customized-label><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes><rows></rows><cols></cols></table><simple-id uuid='{A303B63D-D2B3-4F9B-BDB0-8EDDE2E9BC56}' /></worksheet><worksheet name='KPI Pulau Paling Tercemar'><layout-options><title><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='13' fontalignment='1'>Pulau Paling Tercemar</run></formatted-text></title></layout-options><table><view><datasources><datasource caption='Stasiun Bulanan' name='federated.sb' /><datasource name='Parameters' /></datasources><datasource-dependencies datasource='Parameters'><column caption='Pulau' datatype='string' name='[p_pulau]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua pulau&quot;'><calculation class='tableau' formula='&quot;Semua pulau&quot;' /><members><member value='&quot;Semua pulau&quot;' /><member value='&quot;Sumatera&quot;' /><member value='&quot;Jawa&quot;' /><member value='&quot;Kalimantan&quot;' /><member value='&quot;Sulawesi&quot;' /><member value='&quot;Papua&quot;' /></members></column><column caption='Tipe Lokasi' datatype='string' name='[p_tipe]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua tipe lokasi&quot;'><calculation class='tableau' formula='&quot;Semua tipe lokasi&quot;' /><members><member value='&quot;Semua tipe lokasi&quot;' /><member value='&quot;Perkotaan&quot;' /><member value='&quot;Tepi jalan&quot;' /><member value='&quot;Industri&quot;' /><member value='&quot;Gambut / karhutla&quot;' /><member value='&quot;Latar bersih&quot;' /></members></column><column caption='Musim' datatype='string' name='[p_musim]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua musim&quot;'><calculation class='tableau' formula='&quot;Semua musim&quot;' /><members><member value='&quot;Semua musim&quot;' /><member value='&quot;Hujan (Nov–Apr)&quot;' /><member value='&quot;Kemarau (Mei–Okt)&quot;' /><member value='&quot;Puncak kabut (Agu–Okt)&quot;' /></members></column><column caption='Tahun' datatype='string' name='[p_tahun]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua tahun&quot;'><calculation class='tableau' formula='&quot;Semua tahun&quot;' /><members><member value='&quot;Semua tahun&quot;' /><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Polutan' datatype='string' name='[p_pol]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;SO₂&quot;' /><member value='&quot;CO&quot;' /><member value='&quot;O₃&quot;' /><member value='&quot;NO₂&quot;' /></members></column><column caption='Polutan per Jam' datatype='string' name='[p_jam]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /><member value='&quot;O₃&quot;' /></members></column><column caption='Polutan Hari Kerja' datatype='string' name='[p_pekan]' param-domain-type='list' role='measure' type='nominal' value='&quot;NO₂&quot;'><calculation class='tableau' formula='&quot;NO₂&quot;' /><members><member value='&quot;NO₂&quot;' /><member value='&quot;PM2.5&quot;' /></members></column><column caption='Polutan Lalu Lintas' datatype='string' name='[p_lalin]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /></members></column><column caption='Tahun Baku Mutu' datatype='string' name='[p_thbm]' param-domain-type='list' role='measure' type='nominal' value='&quot;2025&quot;'><calculation class='tableau' formula='&quot;2025&quot;' /><members><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Jenis Kasus' datatype='string' name='[p_kasus]' param-domain-type='list' role='measure' type='nominal' value='&quot;ISPA balita&quot;'><calculation class='tableau' formula='&quot;ISPA balita&quot;' /><members><member value='&quot;ISPA balita&quot;' /><member value='&quot;ISPA lansia&quot;' /><member value='&quot;Darurat asma&quot;' /><member value='&quot;PPOK&quot;' /><member value='&quot;Pernapasan umum&quot;' /><member value='&quot;Kardiovaskular&quot;' /><member value='&quot;Kematian&quot;' /></members></column><column caption='Rumah Sakit' datatype='string' name='[p_rs]' param-domain-type='list' role='measure' type='nominal' value='&quot;RS-XXX-04 (KTG-01)&quot;'><calculation class='tableau' formula='&quot;RS-XXX-04 (KTG-01)&quot;' /><members><member value='&quot;RS-XXX-01 (JKT-01)&quot;' /><member value='&quot;RS-XXX-02 (JKT-02)&quot;' /><member value='&quot;RS-XXX-03 (JKT-03)&quot;' /><member value='&quot;RS-XXX-04 (KTG-01)&quot;' /><member value='&quot;RS-XXX-05 (KTG-02)&quot;' /><member value='&quot;RS-XXX-06 (BGR-01)&quot;' /><member value='&quot;RS-XXX-07 (BGR-02)&quot;' /><member value='&quot;RS-XXX-08 (YKY-01)&quot;' /><member value='&quot;RS-XXX-09 (IDP-01)&quot;' /><member value='&quot;RS-XXX-10 (KTB-01)&quot;' /><member value='&quot;RS-XXX-11 (PKU-01)&quot;' /><member value='&quot;RS-XXX-12 (JMB-01)&quot;' /><member value='&quot;RS-XXX-13 (BTM-01)&quot;' /><member value='&quot;RS-XXX-14 (BGL-01)&quot;' /><member value='&quot;RS-XXX-15 (SRG-01)&quot;' /><member value='&quot;RS-XXX-16 (MLG-01)&quot;' /><member value='&quot;RS-XXX-17 (MRS-01)&quot;' /><member value='&quot;RS-XXX-18 (PLU-01)&quot;' /><member value='&quot;RS-XXX-19 (STG-01)&quot;' /><member value='&quot;RS-XXX-20 (PKN-01)&quot;' /><member value='&quot;RS-XXX-21 (PLB-01)&quot;' /><member value='&quot;RS-XXX-22 (PSW-01)&quot;' /><member value='&quot;RS-XXX-23 (MER-01)&quot;' /><member value='&quot;RS-XXX-24 (MDN-01)&quot;' /><member value='&quot;RS-XXX-25 (SM2-01)&quot;' /><member value='&quot;RS-XXX-26 (BJB-01)&quot;' /><member value='&quot;RS-XXX-27 (JMB-02)&quot;' /></members></column><column caption='Baku Mutu Tahunan PM2.5' datatype='real' name='[p_bm15]' param-domain-type='any' role='measure' type='quantitative' value='15.0'><calculation class='tableau' formula='15.0' /></column><column caption='Baku Mutu 24 Jam PM2.5' datatype='real' name='[p_bm55]' param-domain-type='any' role='measure' type='quantitative' value='55.0'><calculation class='tableau' formula='55.0' /></column><column caption='Risiko Relatif 1' datatype='real' name='[p_rr1]' param-domain-type='any' role='measure' type='quantitative' value='1.0'><calculation class='tableau' formula='1.0' /></column></datasource-dependencies><datasource-dependencies datasource='federated.sb'><column caption='Stasiun' datatype='string' name='[stasiun]' role='dimension' type='nominal' /><column caption='Kota/Kabupaten' datatype='string' name='[kota]' role='dimension' type='nominal' /><column caption='Provinsi' datatype='string' name='[provinsi]' role='dimension' type='nominal' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' role='dimension' type='nominal' /><column caption='Lintang' datatype='real' name='[lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' /><column caption='Bujur' datatype='real' name='[lon]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' /><column datatype='integer' name='[dipakai]' role='dimension' type='ordinal' /><column caption='Rumah Sakit' datatype='string' name='[rumah_sakit]' role='dimension' type='nominal' /><column caption='Tahun' datatype='integer' name='[tahun]' role='dimension' type='ordinal' /><column caption='Bulan' datatype='integer' name='[bulan]' role='dimension' type='ordinal'><aliases><alias key='1' value='Jan' /><alias key='2' value='Feb' /><alias key='3' value='Mar' /><alias key='4' value='Apr' /><alias key='5' value='Mei' /><alias key='6' value='Jun' /><alias key='7' value='Jul' /><alias key='8' value='Agu' /><alias key='9' value='Sep' /><alias key='10' value='Okt' /><alias key='11' value='Nov' /><alias key='12' value='Des' /></aliases></column><column datatype='string' name='[nama_bulan]' role='dimension' type='nominal' /><column caption='Periode' datatype='date' name='[periode]' role='dimension' type='ordinal' /><column caption='Musim' datatype='string' name='[musim]' role='dimension' type='nominal' /><column datatype='integer' name='[puncak_kabut]' role='dimension' type='ordinal' /><column datatype='real' name='[hs_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_pm25]' role='measure' type='quantitative' /><column datatype='real' name='[ds_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_pm25]' role='measure' type='quantitative' /><column datatype='real' name='[hs_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_pm10]' role='measure' type='quantitative' /><column datatype='real' name='[ds_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_pm10]' role='measure' type='quantitative' /><column datatype='real' name='[hs_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_so2]' role='measure' type='quantitative' /><column datatype='real' name='[ds_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_so2]' role='measure' type='quantitative' /><column datatype='real' name='[hs_co]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_co]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_co]' role='measure' type='quantitative' /><column datatype='real' name='[ds_co]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_co]' role='measure' type='quantitative' /><column datatype='real' name='[hs_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_o3]' role='measure' type='quantitative' /><column datatype='real' name='[ds_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_o3]' role='measure' type='quantitative' /><column datatype='real' name='[hs_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_no2]' role='measure' type='quantitative' /><column datatype='real' name='[ds_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_baik]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_sedang]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_tidak_sehat]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_sangat_tidak_sehat]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_berbahaya]' role='measure' type='quantitative' /><column caption='Hari Kabut' datatype='integer' default-format='n#,##0' name='[hari_kabut_asap]' role='measure' type='quantitative' /><column datatype='real' name='[pm25_harian_maks]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_rs]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_balita]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_lansia]' role='measure' type='quantitative' /><column datatype='integer' name='[darurat_asma]' role='measure' type='quantitative' /><column datatype='integer' name='[ppok]' role='measure' type='quantitative' /><column datatype='integer' name='[pernapasan_umum]' role='measure' type='quantitative' /><column datatype='integer' name='[kardiovaskular]' role='measure' type='quantitative' /><column datatype='integer' name='[kematian]' role='measure' type='quantitative' /><column caption='Filter Udara' datatype='boolean' name='[Calculation_sb001]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND ([Parameters].[p_musim] = &quot;Semua musim&quot; OR ([Parameters].[p_musim] = &quot;Hujan (Nov–Apr)&quot; AND ([bulan] &gt;= 11 OR [bulan] &lt;= 4)) OR ([Parameters].[p_musim] = &quot;Kemarau (Mei–Okt)&quot; AND [bulan] &gt;= 5 AND [bulan] &lt;= 10) OR ([Parameters].[p_musim] = &quot;Puncak kabut (Agu–Okt)&quot; AND [bulan] &gt;= 8 AND [bulan] &lt;= 10)) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun]) AND [dipakai] = 1' /></column><column caption='Filter Semua RS' datatype='boolean' name='[Calculation_sb002]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND ([Parameters].[p_musim] = &quot;Semua musim&quot; OR ([Parameters].[p_musim] = &quot;Hujan (Nov–Apr)&quot; AND ([bulan] &gt;= 11 OR [bulan] &lt;= 4)) OR ([Parameters].[p_musim] = &quot;Kemarau (Mei–Okt)&quot; AND [bulan] &gt;= 5 AND [bulan] &lt;= 10) OR ([Parameters].[p_musim] = &quot;Puncak kabut (Agu–Okt)&quot; AND [bulan] &gt;= 8 AND [bulan] &lt;= 10)) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun])' /></column><column caption='PM2.5 Rata-Rata Stasiun' datatype='real' default-format='n#,##0.0' name='[Calculation_sb003]' role='measure' type='quantitative'><calculation class='tableau' formula='{INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END}' /></column><column caption='PM2.5 Rata-Rata' datatype='real' default-format='n#,##0.0' name='[Calculation_sb004]' role='measure' type='quantitative'><calculation class='tableau' formula='IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END' /></column><column caption='Kategori PM2.5' datatype='string' name='[Calculation_sb005]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([Calculation_sb004]) THEN NULL ELSEIF [Calculation_sb004] &lt;= 15.5 THEN &quot;Baik&quot; ELSEIF [Calculation_sb004] &lt;= 55.4 THEN &quot;Sedang&quot; ELSEIF [Calculation_sb004] &lt;= 150.4 THEN &quot;Tidak Sehat&quot; ELSEIF [Calculation_sb004] &lt;= 250.4 THEN &quot;Sangat Tidak Sehat&quot; ELSE &quot;Berbahaya&quot; END' /></column><column caption='Hari Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb006]' role='measure' type='quantitative'><calculation class='tableau' formula='(SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya])) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Baik' datatype='real' default-format='p0.0%' name='[Calculation_sb007]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_baik]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Sedang' datatype='real' default-format='p0.0%' name='[Calculation_sb008]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_sedang]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb009]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_tidak_sehat]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Sangat Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb010]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_sangat_tidak_sehat]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Berbahaya' datatype='real' default-format='p0.0%' name='[Calculation_sb011]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_berbahaya]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='hs Terpilih' datatype='real' name='[Calculation_sb012]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [hs_pm25] WHEN &quot;PM10&quot; THEN [hs_pm10] WHEN &quot;SO₂&quot; THEN [hs_so2] WHEN &quot;CO&quot; THEN [hs_co] WHEN &quot;O₃&quot; THEN [hs_o3] WHEN &quot;NO₂&quot; THEN [hs_no2] END' /></column><column caption='hn Terpilih' datatype='real' name='[Calculation_sb013]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [hn_pm25] WHEN &quot;PM10&quot; THEN [hn_pm10] WHEN &quot;SO₂&quot; THEN [hn_so2] WHEN &quot;CO&quot; THEN [hn_co] WHEN &quot;O₃&quot; THEN [hn_o3] WHEN &quot;NO₂&quot; THEN [hn_no2] END' /></column><column caption='vd Terpilih' datatype='real' name='[Calculation_sb014]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [vd_pm25] WHEN &quot;PM10&quot; THEN [vd_pm10] WHEN &quot;SO₂&quot; THEN [vd_so2] WHEN &quot;CO&quot; THEN [vd_co] WHEN &quot;O₃&quot; THEN [vd_o3] WHEN &quot;NO₂&quot; THEN [vd_no2] END' /></column><column caption='ds Terpilih' datatype='real' name='[Calculation_sb015]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [ds_pm25] WHEN &quot;PM10&quot; THEN [ds_pm10] WHEN &quot;SO₂&quot; THEN [ds_so2] WHEN &quot;CO&quot; THEN [ds_co] WHEN &quot;O₃&quot; THEN [ds_o3] WHEN &quot;NO₂&quot; THEN [ds_no2] END' /></column><column caption='dn Terpilih' datatype='real' name='[Calculation_sb016]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [dn_pm25] WHEN &quot;PM10&quot; THEN [dn_pm10] WHEN &quot;SO₂&quot; THEN [dn_so2] WHEN &quot;CO&quot; THEN [dn_co] WHEN &quot;O₃&quot; THEN [dn_o3] WHEN &quot;NO₂&quot; THEN [dn_no2] END' /></column><column caption='Rata-Rata Stasiun (Polutan Terpilih)' datatype='real' default-format='n#,##0.0' name='[Calculation_sb017]' role='measure' type='quantitative'><calculation class='tableau' formula='{INCLUDE [stasiun] : IF SUM([Calculation_sb014]) &gt;= 10 THEN SUM([Calculation_sb012]) / SUM([Calculation_sb013]) END}' /></column><column caption='Rata-Rata (Polutan Terpilih)' datatype='real' default-format='n#,##0.0' name='[Calculation_sb018]' role='measure' type='quantitative'><calculation class='tableau' formula='IF SUM([Calculation_sb014]) &gt;= 10 THEN SUM([Calculation_sb012]) / SUM([Calculation_sb013]) END' /></column><column caption='Rata-Rata Bulanan' datatype='real' default-format='n#,##0.0' name='[Calculation_sb019]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Calculation_sb015]) / SUM([Calculation_sb016])' /></column><column caption='Baku Mutu Tahunan' datatype='real' name='[Calculation_sb020]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 15 WHEN &quot;PM10&quot; THEN 40 WHEN &quot;SO₂&quot; THEN 45 WHEN &quot;NO₂&quot; THEN 50 WHEN &quot;O₃&quot; THEN 35 END' /></column><column caption='Pedoman WHO Tahunan' datatype='real' name='[Calculation_sb021]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 5 WHEN &quot;PM10&quot; THEN 15 WHEN &quot;NO₂&quot; THEN 10 END' /></column><column caption='Baku Mutu 24 Jam' datatype='real' name='[Calculation_sb022]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 55 WHEN &quot;PM10&quot; THEN 75 WHEN &quot;SO₂&quot; THEN 75 WHEN &quot;NO₂&quot; THEN 65 END' /></column><column caption='Melampaui Baku Mutu' datatype='string' name='[Calculation_sb023]' role='measure' type='nominal'><calculation class='tableau' formula='STR(SUM({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 AND SUM([hs_pm25]) / SUM([hn_pm25]) &gt; 15 THEN 1 ELSE 0 END})) + &quot; / &quot; + STR(SUM({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN 1 ELSE 0 END}))' /></column><column caption='Pulau Paling Tercemar' datatype='string' name='[Calculation_sb024]' role='measure' type='nominal'><calculation class='tableau' formula='MID(MAX({INCLUDE [pulau] : STR(INT(10000 + ROUND(AVG({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END}) * 10, 0))) + MIN([pulau])}), 6)' /></column><column-instance column='[Calculation_sb001]' derivation='None' name='[none:Calculation_sb001:nk]' pivot='key' type='nominal' /><column-instance column='[Calculation_sb024]' derivation='User' name='[usr:Calculation_sb024:nk]' pivot='key' type='nominal' /></datasource-dependencies><filter class='categorical' column='[federated.sb].[none:Calculation_sb001:nk]'><groupfilter function='member' level='[none:Calculation_sb001:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.sb].[none:Calculation_sb001:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule><style-rule element='all'><format attr='font-family' value='Helvetica Neue' /><format attr='color' value='#000000' /></style-rule><style-rule element='cell'><format attr='text-align' value='center' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.sb].[usr:Calculation_sb024:nk]' /></encodings><customized-label><formatted-text><run fontalignment='1' fontcolor='#000000' fontname='Helvetica Neue' fontsize='26'><![CDATA[<[federated.sb].[usr:Calculation_sb024:nk]>]]></run></formatted-text></customized-label><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes><rows></rows><cols></cols></table><simple-id uuid='{5533E270-5F43-4913-BF08-6924B4ADB064}' /></worksheet><worksheet name='KPI Rata-Rata Polutan'><layout-options><title><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='13' fontalignment='1'>Rata-Rata Polutan Terpilih</run></formatted-text></title></layout-options><table><view><datasources><datasource caption='Stasiun Bulanan' name='federated.sb' /><datasource name='Parameters' /></datasources><datasource-dependencies datasource='Parameters'><column caption='Pulau' datatype='string' name='[p_pulau]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua pulau&quot;'><calculation class='tableau' formula='&quot;Semua pulau&quot;' /><members><member value='&quot;Semua pulau&quot;' /><member value='&quot;Sumatera&quot;' /><member value='&quot;Jawa&quot;' /><member value='&quot;Kalimantan&quot;' /><member value='&quot;Sulawesi&quot;' /><member value='&quot;Papua&quot;' /></members></column><column caption='Tipe Lokasi' datatype='string' name='[p_tipe]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua tipe lokasi&quot;'><calculation class='tableau' formula='&quot;Semua tipe lokasi&quot;' /><members><member value='&quot;Semua tipe lokasi&quot;' /><member value='&quot;Perkotaan&quot;' /><member value='&quot;Tepi jalan&quot;' /><member value='&quot;Industri&quot;' /><member value='&quot;Gambut / karhutla&quot;' /><member value='&quot;Latar bersih&quot;' /></members></column><column caption='Musim' datatype='string' name='[p_musim]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua musim&quot;'><calculation class='tableau' formula='&quot;Semua musim&quot;' /><members><member value='&quot;Semua musim&quot;' /><member value='&quot;Hujan (Nov–Apr)&quot;' /><member value='&quot;Kemarau (Mei–Okt)&quot;' /><member value='&quot;Puncak kabut (Agu–Okt)&quot;' /></members></column><column caption='Tahun' datatype='string' name='[p_tahun]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua tahun&quot;'><calculation class='tableau' formula='&quot;Semua tahun&quot;' /><members><member value='&quot;Semua tahun&quot;' /><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Polutan' datatype='string' name='[p_pol]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;SO₂&quot;' /><member value='&quot;CO&quot;' /><member value='&quot;O₃&quot;' /><member value='&quot;NO₂&quot;' /></members></column><column caption='Polutan per Jam' datatype='string' name='[p_jam]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /><member value='&quot;O₃&quot;' /></members></column><column caption='Polutan Hari Kerja' datatype='string' name='[p_pekan]' param-domain-type='list' role='measure' type='nominal' value='&quot;NO₂&quot;'><calculation class='tableau' formula='&quot;NO₂&quot;' /><members><member value='&quot;NO₂&quot;' /><member value='&quot;PM2.5&quot;' /></members></column><column caption='Polutan Lalu Lintas' datatype='string' name='[p_lalin]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /></members></column><column caption='Tahun Baku Mutu' datatype='string' name='[p_thbm]' param-domain-type='list' role='measure' type='nominal' value='&quot;2025&quot;'><calculation class='tableau' formula='&quot;2025&quot;' /><members><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Jenis Kasus' datatype='string' name='[p_kasus]' param-domain-type='list' role='measure' type='nominal' value='&quot;ISPA balita&quot;'><calculation class='tableau' formula='&quot;ISPA balita&quot;' /><members><member value='&quot;ISPA balita&quot;' /><member value='&quot;ISPA lansia&quot;' /><member value='&quot;Darurat asma&quot;' /><member value='&quot;PPOK&quot;' /><member value='&quot;Pernapasan umum&quot;' /><member value='&quot;Kardiovaskular&quot;' /><member value='&quot;Kematian&quot;' /></members></column><column caption='Rumah Sakit' datatype='string' name='[p_rs]' param-domain-type='list' role='measure' type='nominal' value='&quot;RS-XXX-04 (KTG-01)&quot;'><calculation class='tableau' formula='&quot;RS-XXX-04 (KTG-01)&quot;' /><members><member value='&quot;RS-XXX-01 (JKT-01)&quot;' /><member value='&quot;RS-XXX-02 (JKT-02)&quot;' /><member value='&quot;RS-XXX-03 (JKT-03)&quot;' /><member value='&quot;RS-XXX-04 (KTG-01)&quot;' /><member value='&quot;RS-XXX-05 (KTG-02)&quot;' /><member value='&quot;RS-XXX-06 (BGR-01)&quot;' /><member value='&quot;RS-XXX-07 (BGR-02)&quot;' /><member value='&quot;RS-XXX-08 (YKY-01)&quot;' /><member value='&quot;RS-XXX-09 (IDP-01)&quot;' /><member value='&quot;RS-XXX-10 (KTB-01)&quot;' /><member value='&quot;RS-XXX-11 (PKU-01)&quot;' /><member value='&quot;RS-XXX-12 (JMB-01)&quot;' /><member value='&quot;RS-XXX-13 (BTM-01)&quot;' /><member value='&quot;RS-XXX-14 (BGL-01)&quot;' /><member value='&quot;RS-XXX-15 (SRG-01)&quot;' /><member value='&quot;RS-XXX-16 (MLG-01)&quot;' /><member value='&quot;RS-XXX-17 (MRS-01)&quot;' /><member value='&quot;RS-XXX-18 (PLU-01)&quot;' /><member value='&quot;RS-XXX-19 (STG-01)&quot;' /><member value='&quot;RS-XXX-20 (PKN-01)&quot;' /><member value='&quot;RS-XXX-21 (PLB-01)&quot;' /><member value='&quot;RS-XXX-22 (PSW-01)&quot;' /><member value='&quot;RS-XXX-23 (MER-01)&quot;' /><member value='&quot;RS-XXX-24 (MDN-01)&quot;' /><member value='&quot;RS-XXX-25 (SM2-01)&quot;' /><member value='&quot;RS-XXX-26 (BJB-01)&quot;' /><member value='&quot;RS-XXX-27 (JMB-02)&quot;' /></members></column><column caption='Baku Mutu Tahunan PM2.5' datatype='real' name='[p_bm15]' param-domain-type='any' role='measure' type='quantitative' value='15.0'><calculation class='tableau' formula='15.0' /></column><column caption='Baku Mutu 24 Jam PM2.5' datatype='real' name='[p_bm55]' param-domain-type='any' role='measure' type='quantitative' value='55.0'><calculation class='tableau' formula='55.0' /></column><column caption='Risiko Relatif 1' datatype='real' name='[p_rr1]' param-domain-type='any' role='measure' type='quantitative' value='1.0'><calculation class='tableau' formula='1.0' /></column></datasource-dependencies><datasource-dependencies datasource='federated.sb'><column caption='Stasiun' datatype='string' name='[stasiun]' role='dimension' type='nominal' /><column caption='Kota/Kabupaten' datatype='string' name='[kota]' role='dimension' type='nominal' /><column caption='Provinsi' datatype='string' name='[provinsi]' role='dimension' type='nominal' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' role='dimension' type='nominal' /><column caption='Lintang' datatype='real' name='[lat]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' /><column caption='Bujur' datatype='real' name='[lon]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' /><column datatype='integer' name='[dipakai]' role='dimension' type='ordinal' /><column caption='Rumah Sakit' datatype='string' name='[rumah_sakit]' role='dimension' type='nominal' /><column caption='Tahun' datatype='integer' name='[tahun]' role='dimension' type='ordinal' /><column caption='Bulan' datatype='integer' name='[bulan]' role='dimension' type='ordinal'><aliases><alias key='1' value='Jan' /><alias key='2' value='Feb' /><alias key='3' value='Mar' /><alias key='4' value='Apr' /><alias key='5' value='Mei' /><alias key='6' value='Jun' /><alias key='7' value='Jul' /><alias key='8' value='Agu' /><alias key='9' value='Sep' /><alias key='10' value='Okt' /><alias key='11' value='Nov' /><alias key='12' value='Des' /></aliases></column><column datatype='string' name='[nama_bulan]' role='dimension' type='nominal' /><column caption='Periode' datatype='date' name='[periode]' role='dimension' type='ordinal' /><column caption='Musim' datatype='string' name='[musim]' role='dimension' type='nominal' /><column datatype='integer' name='[puncak_kabut]' role='dimension' type='ordinal' /><column datatype='real' name='[hs_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_pm25]' role='measure' type='quantitative' /><column datatype='real' name='[ds_pm25]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_pm25]' role='measure' type='quantitative' /><column datatype='real' name='[hs_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_pm10]' role='measure' type='quantitative' /><column datatype='real' name='[ds_pm10]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_pm10]' role='measure' type='quantitative' /><column datatype='real' name='[hs_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_so2]' role='measure' type='quantitative' /><column datatype='real' name='[ds_so2]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_so2]' role='measure' type='quantitative' /><column datatype='real' name='[hs_co]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_co]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_co]' role='measure' type='quantitative' /><column datatype='real' name='[ds_co]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_co]' role='measure' type='quantitative' /><column datatype='real' name='[hs_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_o3]' role='measure' type='quantitative' /><column datatype='real' name='[ds_o3]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_o3]' role='measure' type='quantitative' /><column datatype='real' name='[hs_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[hn_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[vd_no2]' role='measure' type='quantitative' /><column datatype='real' name='[ds_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[dn_no2]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_baik]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_sedang]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_tidak_sehat]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_sangat_tidak_sehat]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_berbahaya]' role='measure' type='quantitative' /><column caption='Hari Kabut' datatype='integer' default-format='n#,##0' name='[hari_kabut_asap]' role='measure' type='quantitative' /><column datatype='real' name='[pm25_harian_maks]' role='measure' type='quantitative' /><column datatype='integer' name='[hari_rs]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_balita]' role='measure' type='quantitative' /><column datatype='integer' name='[ispa_lansia]' role='measure' type='quantitative' /><column datatype='integer' name='[darurat_asma]' role='measure' type='quantitative' /><column datatype='integer' name='[ppok]' role='measure' type='quantitative' /><column datatype='integer' name='[pernapasan_umum]' role='measure' type='quantitative' /><column datatype='integer' name='[kardiovaskular]' role='measure' type='quantitative' /><column datatype='integer' name='[kematian]' role='measure' type='quantitative' /><column caption='Filter Udara' datatype='boolean' name='[Calculation_sb001]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND ([Parameters].[p_musim] = &quot;Semua musim&quot; OR ([Parameters].[p_musim] = &quot;Hujan (Nov–Apr)&quot; AND ([bulan] &gt;= 11 OR [bulan] &lt;= 4)) OR ([Parameters].[p_musim] = &quot;Kemarau (Mei–Okt)&quot; AND [bulan] &gt;= 5 AND [bulan] &lt;= 10) OR ([Parameters].[p_musim] = &quot;Puncak kabut (Agu–Okt)&quot; AND [bulan] &gt;= 8 AND [bulan] &lt;= 10)) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun]) AND [dipakai] = 1' /></column><column caption='Filter Semua RS' datatype='boolean' name='[Calculation_sb002]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND ([Parameters].[p_musim] = &quot;Semua musim&quot; OR ([Parameters].[p_musim] = &quot;Hujan (Nov–Apr)&quot; AND ([bulan] &gt;= 11 OR [bulan] &lt;= 4)) OR ([Parameters].[p_musim] = &quot;Kemarau (Mei–Okt)&quot; AND [bulan] &gt;= 5 AND [bulan] &lt;= 10) OR ([Parameters].[p_musim] = &quot;Puncak kabut (Agu–Okt)&quot; AND [bulan] &gt;= 8 AND [bulan] &lt;= 10)) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun])' /></column><column caption='PM2.5 Rata-Rata Stasiun' datatype='real' default-format='n#,##0.0' name='[Calculation_sb003]' role='measure' type='quantitative'><calculation class='tableau' formula='{INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END}' /></column><column caption='PM2.5 Rata-Rata' datatype='real' default-format='n#,##0.0' name='[Calculation_sb004]' role='measure' type='quantitative'><calculation class='tableau' formula='IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END' /></column><column caption='Kategori PM2.5' datatype='string' name='[Calculation_sb005]' role='dimension' type='nominal'><calculation class='tableau' formula='IF ISNULL([Calculation_sb004]) THEN NULL ELSEIF [Calculation_sb004] &lt;= 15.5 THEN &quot;Baik&quot; ELSEIF [Calculation_sb004] &lt;= 55.4 THEN &quot;Sedang&quot; ELSEIF [Calculation_sb004] &lt;= 150.4 THEN &quot;Tidak Sehat&quot; ELSEIF [Calculation_sb004] &lt;= 250.4 THEN &quot;Sangat Tidak Sehat&quot; ELSE &quot;Berbahaya&quot; END' /></column><column caption='Hari Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb006]' role='measure' type='quantitative'><calculation class='tableau' formula='(SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya])) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Baik' datatype='real' default-format='p0.0%' name='[Calculation_sb007]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_baik]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Sedang' datatype='real' default-format='p0.0%' name='[Calculation_sb008]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_sedang]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb009]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_tidak_sehat]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Sangat Tidak Sehat' datatype='real' default-format='p0.0%' name='[Calculation_sb010]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_sangat_tidak_sehat]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='Berbahaya' datatype='real' default-format='p0.0%' name='[Calculation_sb011]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([hari_berbahaya]) / (SUM([hari_baik]) + SUM([hari_sedang]) + SUM([hari_tidak_sehat]) + SUM([hari_sangat_tidak_sehat]) + SUM([hari_berbahaya]))' /></column><column caption='hs Terpilih' datatype='real' name='[Calculation_sb012]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [hs_pm25] WHEN &quot;PM10&quot; THEN [hs_pm10] WHEN &quot;SO₂&quot; THEN [hs_so2] WHEN &quot;CO&quot; THEN [hs_co] WHEN &quot;O₃&quot; THEN [hs_o3] WHEN &quot;NO₂&quot; THEN [hs_no2] END' /></column><column caption='hn Terpilih' datatype='real' name='[Calculation_sb013]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [hn_pm25] WHEN &quot;PM10&quot; THEN [hn_pm10] WHEN &quot;SO₂&quot; THEN [hn_so2] WHEN &quot;CO&quot; THEN [hn_co] WHEN &quot;O₃&quot; THEN [hn_o3] WHEN &quot;NO₂&quot; THEN [hn_no2] END' /></column><column caption='vd Terpilih' datatype='real' name='[Calculation_sb014]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [vd_pm25] WHEN &quot;PM10&quot; THEN [vd_pm10] WHEN &quot;SO₂&quot; THEN [vd_so2] WHEN &quot;CO&quot; THEN [vd_co] WHEN &quot;O₃&quot; THEN [vd_o3] WHEN &quot;NO₂&quot; THEN [vd_no2] END' /></column><column caption='ds Terpilih' datatype='real' name='[Calculation_sb015]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [ds_pm25] WHEN &quot;PM10&quot; THEN [ds_pm10] WHEN &quot;SO₂&quot; THEN [ds_so2] WHEN &quot;CO&quot; THEN [ds_co] WHEN &quot;O₃&quot; THEN [ds_o3] WHEN &quot;NO₂&quot; THEN [ds_no2] END' /></column><column caption='dn Terpilih' datatype='real' name='[Calculation_sb016]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN [dn_pm25] WHEN &quot;PM10&quot; THEN [dn_pm10] WHEN &quot;SO₂&quot; THEN [dn_so2] WHEN &quot;CO&quot; THEN [dn_co] WHEN &quot;O₃&quot; THEN [dn_o3] WHEN &quot;NO₂&quot; THEN [dn_no2] END' /></column><column caption='Rata-Rata Stasiun (Polutan Terpilih)' datatype='real' default-format='n#,##0.0' name='[Calculation_sb017]' role='measure' type='quantitative'><calculation class='tableau' formula='{INCLUDE [stasiun] : IF SUM([Calculation_sb014]) &gt;= 10 THEN SUM([Calculation_sb012]) / SUM([Calculation_sb013]) END}' /></column><column caption='Rata-Rata (Polutan Terpilih)' datatype='real' default-format='n#,##0.0' name='[Calculation_sb018]' role='measure' type='quantitative'><calculation class='tableau' formula='IF SUM([Calculation_sb014]) &gt;= 10 THEN SUM([Calculation_sb012]) / SUM([Calculation_sb013]) END' /></column><column caption='Rata-Rata Bulanan' datatype='real' default-format='n#,##0.0' name='[Calculation_sb019]' role='measure' type='quantitative'><calculation class='tableau' formula='SUM([Calculation_sb015]) / SUM([Calculation_sb016])' /></column><column caption='Baku Mutu Tahunan' datatype='real' name='[Calculation_sb020]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 15 WHEN &quot;PM10&quot; THEN 40 WHEN &quot;SO₂&quot; THEN 45 WHEN &quot;NO₂&quot; THEN 50 WHEN &quot;O₃&quot; THEN 35 END' /></column><column caption='Pedoman WHO Tahunan' datatype='real' name='[Calculation_sb021]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 5 WHEN &quot;PM10&quot; THEN 15 WHEN &quot;NO₂&quot; THEN 10 END' /></column><column caption='Baku Mutu 24 Jam' datatype='real' name='[Calculation_sb022]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_pol] WHEN &quot;PM2.5&quot; THEN 55 WHEN &quot;PM10&quot; THEN 75 WHEN &quot;SO₂&quot; THEN 75 WHEN &quot;NO₂&quot; THEN 65 END' /></column><column caption='Melampaui Baku Mutu' datatype='string' name='[Calculation_sb023]' role='measure' type='nominal'><calculation class='tableau' formula='STR(SUM({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 AND SUM([hs_pm25]) / SUM([hn_pm25]) &gt; 15 THEN 1 ELSE 0 END})) + &quot; / &quot; + STR(SUM({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN 1 ELSE 0 END}))' /></column><column caption='Pulau Paling Tercemar' datatype='string' name='[Calculation_sb024]' role='measure' type='nominal'><calculation class='tableau' formula='MID(MAX({INCLUDE [pulau] : STR(INT(10000 + ROUND(AVG({INCLUDE [stasiun] : IF SUM([vd_pm25]) &gt;= 10 THEN SUM([hs_pm25]) / SUM([hn_pm25]) END}) * 10, 0))) + MIN([pulau])}), 6)' /></column><column-instance column='[Calculation_sb017]' derivation='Avg' name='[avg:Calculation_sb017:qk]' pivot='key' type='quantitative' /><column-instance column='[Calculation_sb001]' derivation='None' name='[none:Calculation_sb001:nk]' pivot='key' type='nominal' /></datasource-dependencies><filter class='categorical' column='[federated.sb].[none:Calculation_sb001:nk]'><groupfilter function='member' level='[none:Calculation_sb001:nk]' member='true' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' /></filter><slices><column>[federated.sb].[none:Calculation_sb001:nk]</column></slices><aggregation value='true' /></view><style><style-rule element='worksheet'><format attr='display-field-labels' scope='rows' value='false' /><format attr='display-field-labels' scope='cols' value='false' /></style-rule><style-rule element='all'><format attr='font-family' value='Helvetica Neue' /><format attr='color' value='#000000' /></style-rule><style-rule element='cell'><format attr='text-align' value='center' /><format attr='text-format' field='[federated.sb].[avg:Calculation_sb017:qk]' value='n#,##0.0&quot; µg/m³&quot;' /></style-rule></style><panes><pane selection-relaxation-option='selection-relaxation-allow'><view><breakdown value='auto' /></view><mark class='Text' /><encodings><text column='[federated.sb].[avg:Calculation_sb017:qk]' /></encodings><customized-label><formatted-text><run fontalignment='1' fontcolor='#000000' fontname='Helvetica Neue' fontsize='26'><![CDATA[<[federated.sb].[avg:Calculation_sb017:qk]>]]></run></formatted-text></customized-label><style><style-rule element='mark'><format attr='mark-labels-show' value='true' /></style-rule></style></pane></panes><rows></rows><cols></cols></table><simple-id uuid='{83CE187A-7AFB-4A50-B22A-2CE52082F447}' /></worksheet><worksheet name='Peringkat Stasiun'><layout-options><title><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='13'>Peringkat Stasiun</run><run fontcolor='#000000'>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='9'>Garis: baku mutu tahunan dan pedoman WHO 2021 untuk polutan terpilih</run></formatted-text></title></layout-options><table><view><datasources><datasource caption='Stasiun Bulanan' name='federated.sb' /><datasource name='Parameters' /></datasources><datasource-dependencies datasource='Parameters'><column caption='Pulau' datatype='string' name='[p_pulau]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua pulau&quot;'><calculation class='tableau' formula='&quot;Semua pulau&quot;' /><members><member value='&quot;Semua pulau&quot;' /><member value='&quot;Sumatera&quot;' /><member value='&quot;Jawa&quot;' /><member value='&quot;Kalimantan&quot;' /><member value='&quot;Sulawesi&quot;' /><member value='&quot;Papua&quot;' /></members></column><column caption='Tipe Lokasi' datatype='string' name='[p_tipe]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua tipe lokasi&quot;'><calculation class='tableau' formula='&quot;Semua tipe lokasi&quot;' /><members><member value='&quot;Semua tipe lokasi&quot;' /><member value='&quot;Perkotaan&quot;' /><member value='&quot;Tepi jalan&quot;' /><member value='&quot;Industri&quot;' /><member value='&quot;Gambut / karhutla&quot;' /><member value='&quot;Latar bersih&quot;' /></members></column><column caption='Musim' datatype='string' name='[p_musim]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua musim&quot;'><calculation class='tableau' formula='&quot;Semua musim&quot;' /><members><member value='&quot;Semua musim&quot;' /><member value='&quot;Hujan (Nov–Apr)&quot;' /><member value='&quot;Kemarau (Mei–Okt)&quot;' /><member value='&quot;Puncak kabut (Agu–Okt)&quot;' /></members></column><column caption='Tahun' datatype='string' name='[p_tahun]' param-domain-type='list' role='measure' type='nominal' value='&quot;Semua tahun&quot;'><calculation class='tableau' formula='&quot;Semua tahun&quot;' /><members><member value='&quot;Semua tahun&quot;' /><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Polutan' datatype='string' name='[p_pol]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;SO₂&quot;' /><member value='&quot;CO&quot;' /><member value='&quot;O₃&quot;' /><member value='&quot;NO₂&quot;' /></members></column><column caption='Polutan per Jam' datatype='string' name='[p_jam]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /><member value='&quot;O₃&quot;' /></members></column><column caption='Polutan Hari Kerja' datatype='string' name='[p_pekan]' param-domain-type='list' role='measure' type='nominal' value='&quot;NO₂&quot;'><calculation class='tableau' formula='&quot;NO₂&quot;' /><members><member value='&quot;NO₂&quot;' /><member value='&quot;PM2.5&quot;' /></members></column><column caption='Polutan Lalu Lintas' datatype='string' name='[p_lalin]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /></members></column><column caption='Tahun Baku Mutu' datatype='string' name='[p_thbm]' param-domain-type='list' role='measure' type='nominal' value='&quot;2025&quot;'><calculation class='tableau' formula='&quot;2025&quot;' /><members><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Jenis Kasus' datatype='string' name='[p_kasus]' param-domain-type='list' role='measure' type='nominal' value='&quot;ISPA balita&quot;'><calculation class='tableau' formula='&quot;ISPA balita&quot;' /><members><member value='&quot;ISPA balita&quot;' /><member value='&quot;ISPA lansia&quot;' /><member value='&quot;Darurat asma&quot;' /><member value='&quot;PPOK&quot;' /><member value='&quot;Pernapasan umum&quot;' /><member value='&quot;Kardiovaskular&quot;' /><member value='&quot;Kematian&quot;' /></members></column><column caption='Rumah Sakit' datatype='string' name='[p_rs]' param-domain-type='list' role='measure' type='nominal' value='&quot;RS-XXX-04 (KTG-01)&quot;'><calculation class='tableau' formula='&quot;RS-XXX-04 (KTG-01)&quot;' /><members><member value='&quot;RS-XXX-01 (JKT-01)&quot;' /><member value='&quot;RS-XXX-02 (JKT-02)&quot;' /><member value='&quot;RS-XXX-03 (JKT-03)&quot;' /><member value='&quot;RS-XXX-04 (KTG-01)&quot;' /><member value='&quot;RS-XXX-05 (KTG-02)&quot;' /><member value='&quot;RS-XXX-06 (BGR-01)&quot;' /><member value='&quot;RS-XXX-07 (BGR-02)&quot;' /><member value='&quot;RS-XXX-08 (YKY-01)&quot;' /><member value='&quot;RS-XXX-09 (IDP-01)&quot;' /><member value='&quot;RS-XXX-10 (KTB-01)&quot;' /><member value='&quot;RS-XXX-11 (PKU-01)&quot;' /><member value='&quot;RS-XXX-12 (JMB-01)&quot;' /><member value='&quot;RS-XXX-13 (BTM-01)&quot;' /><member value='&quot;RS-XXX-14 (BGL-01)&quot;' /><member value='&quot;RS-XXX-15 (SRG-01)&quot;' /><member value='&quot;RS-XXX-16 (MLG-01)&quot;' /><member value='&quot;RS-XXX-17 (MRS-01)&quot;' /><member value='&quot;RS-XXX-18 (PLU-01)&quot;' /><member value='&quot;RS-XXX-19 (STG-01)&quot;' /><member value='&quot;RS-XXX-20 (PKN-01)&quot;' /><member value='&quot;RS-XXX-21 (PLB-01)&quot;' /><member value='&quot;RS-XXX-22 (PSW-01)&quot;' /><member value='&quot;RS-XXX-23 (MER-01)&quot;' /><member value='&quot;RS-XXX-24 (MDN-01)&quot;' /><member value='&quot;RS-XXX-25 (SM2-01)&quot;' /><member value='&quot;RS-XXX-26 (BJB-01)&quot;' /><member value='&quot;RS-XXX-27 (JMB-02)&quot;' /></members></column><column caption='Baku Mutu Tahunan PM2.5' datatype='real' name='[p_bm15]' param-domain-type='any' role='measure' type='quantitative' value='15.0'><calculation class='tableau' formula='15.0' /></column><column caption='Baku Mutu 24 Jam PM2.5' datatype='real' name='[p_bm55]' param-domain-type='any' role='measure' type='quantitative' value='55.0'><calculation class='tableau' formula='55.0' /></column><column caption='Risiko Relatif 1' datatype='real' name='[p_rr1]' param-domain-type='any' role='measure' type='quantitative' value='1.0'><calculation class='tableau' formula='1.0' /></column></datasource-dependencies><datasource-dependencies datasource='federated.sb'><column caption='Stasiun' datatype='string' name='[stasiun]' role='dimension' type='nominal' /><column caption='Kota/Kabupaten' datatype='string' name='[kota]' role='dimension' type='nominal' /><column caption='Provinsi' datatype='string' name='[provinsi]' role='dimension' type='nominal' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' r