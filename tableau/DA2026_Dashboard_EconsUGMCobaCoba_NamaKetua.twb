au' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe]) AND ([Parameters].[p_tahun] = &quot;Semua tahun&quot; OR STR([tahun]) = [Parameters].[p_tahun])' /></column></datasource><datasource caption='Kepentingan Faktor' inline='true' name='federated.kf' version='18.1'><connection class='federated'><named-connections><named-connection caption='Kepentingan Faktor' name='hyper.kf'><connection authentication='auth-none' author-locale='en_US' class='hyper' dbname='Data/Extracts/kepentingan_faktor.hyper' default-settings='yes' port='' sslmode='' username='tableau_internal_user' /></named-connection></named-connections><relation connection='hyper.kf' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption='Faktor' datatype='string' name='[faktor]' role='dimension' type='nominal' /><column caption='Penurunan R²' datatype='real' default-format='n#,##0.000' name='[importance]' role='measure' type='quantitative' /><column caption='Porsi Kepentingan (%)' datatype='real' default-format='n#,##0.0' name='[share_pct]' role='measure' type='quantitative' /></datasource><datasource caption='Korelasi Cuaca' inline='true' name='federated.kc' version='18.1'><connection class='federated'><named-connections><named-connection caption='Korelasi Cuaca' name='hyper.kc'><connection authentication='auth-none' author-locale='en_US' class='hyper' dbname='Data/Extracts/korelasi_cuaca.hyper' default-settings='yes' port='' sslmode='' username='tableau_internal_user' /></named-connection></named-connections><relation connection='hyper.kc' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption='Polutan' datatype='string' name='[pollutant]' role='dimension' type='nominal' /><column caption='Faktor Cuaca' datatype='string' name='[factor]' role='dimensio