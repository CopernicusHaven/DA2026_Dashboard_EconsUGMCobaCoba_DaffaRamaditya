ula='&quot;NO₂&quot;' /><members><member value='&quot;NO₂&quot;' /><member value='&quot;PM2.5&quot;' /></members></column><column caption='Polutan Lalu Lintas' datatype='string' name='[p_lalin]' param-domain-type='list' role='measure' type='nominal' value='&quot;PM2.5&quot;'><calculation class='tableau' formula='&quot;PM2.5&quot;' /><members><member value='&quot;PM2.5&quot;' /><member value='&quot;PM10&quot;' /><member value='&quot;NO₂&quot;' /><member value='&quot;CO&quot;' /></members></column><column caption='Tahun Baku Mutu' datatype='string' name='[p_thbm]' param-domain-type='list' role='measure' type='nominal' value='&quot;2025&quot;'><calculation class='tableau' formula='&quot;2025&quot;' /><members><member value='&quot;2024&quot;' /><member value='&quot;2025&quot;' /><member value='&quot;2026&quot;' /></members></column><column caption='Jenis Kasus' datatype='string' name='[p_kasus]' param-domain-type='list' role='measure' type='nominal' value='&quot;ISPA balita&quot;'><calculation class='tableau' formula='&quot;ISPA balita&quot;' /><members><member value='&quot;ISPA balita&quot;' /><member value='&quot;ISPA lansia&quot;' /><member value='&quot;Darurat asma&quot;' /><member value='&quot;PPOK&quot;' /><member value='&quot;Pernapasan umum&quot;' /><member value='&quot;Kardiovaskular&quot;' /><member value='&quot;Kematian&quot;' /></members></column><column caption='Rumah Sakit' datatype='string' name='[p_rs]' param-domain-type='list' role='measure' type='nominal' value='&quot;RS-XXX-04 (KTG-01)&quot;'><calculation class='tableau' formula='&quot;RS-XXX-04 (KTG-01)&quot;' /><members><member value='&quot;RS-XXX-01 (JKT-01)&quot;' /><member value='&quot;RS-XXX-02 (JKT-02)&quot;' /><member value='&quot;RS-XXX-03 (JKT-03)&quot;' /><member value='&quot;RS-XXX-04 (KTG-01)&quot;' /><member value='&quot;RS-XXX-05 (KTG-02)&quot;' /><member value='&quot;RS-XXX-06 (BGR-01)&quot;' /><member value='&quot;RS-XXX-07 (BGR-02)&quot;' /><member value='&quot;RS-XXX-08 (YKY-01)&quo