r value='&quot;RS-XXX-05 (KTG-02)&quot;' /><member value='&quot;RS-XXX-06 (BGR-01)&quot;' /><member value='&quot;RS-XXX-07 (BGR-02)&quot;' /><member value='&quot;RS-XXX-08 (YKY-01)&quot;' /><member value='&quot;RS-XXX-09 (IDP-01)&quot;' /><member value='&quot;RS-XXX-10 (KTB-01)&quot;' /><member value='&quot;RS-XXX-11 (PKU-01)&quot;' /><member value='&quot;RS-XXX-12 (JMB-01)&quot;' /><member value='&quot;RS-XXX-13 (BTM-01)&quot;' /><member value='&quot;RS-XXX-14 (BGL-01)&quot;' /><member value='&quot;RS-XXX-15 (SRG-01)&quot;' /><member value='&quot;RS-XXX-16 (MLG-01)&quot;' /><member value='&quot;RS-XXX-17 (MRS-01)&quot;' /><member value='&quot;RS-XXX-18 (PLU-01)&quot;' /><member value='&quot;RS-XXX-19 (STG-01)&quot;' /><member value='&quot;RS-XXX-20 (PKN-01)&quot;' /><member value='&quot;RS-XXX-21 (PLB-01)&quot;' /><member value='&quot;RS-XXX-22 (PSW-01)&quot;' /><member value='&quot;RS-XXX-23 (MER-01)&quot;' /><member value='&quot;RS-XXX-24 (MDN-01)&quot;' /><member value='&quot;RS-XXX-25 (SM2-01)&quot;' /><member value='&quot;RS-XXX-26 (BJB-01)&quot;' /><member value='&quot;RS-XXX-27 (JMB-02)&quot;' /></members></column><column caption='Baku Mutu Tahunan PM2.5' datatype='real' name='[p_bm15]' param-domain-type='any' role='measure' type='quantitative' value='15.0'><calculation class='tableau' formula='15.0' /></column><column caption='Baku Mutu 24 Jam PM2.5' datatype='real' name='[p_bm55]' param-domain-type='any' role='measure' type='quantitative' value='55.0'><calculation class='tableau' formula='55.0' /></column><column caption='Risiko Relatif 1' datatype='real' name='[p_rr1]' param-domain-type='any' role='measure' type='quantitative' value='1.0'><calculation class='tableau' formula='1.0' /></column></datasource-dependencies><zones><zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0' /><zone h='2296' id='11' is-scaled='1' param='Images/logo_gelar_rasa.png' type-v2='bitmap' w='10667' x='2000' y='835' /><zone h='2088' id='12' type-v2='text' w='58333' x='14500' y='939'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='20'>Petunjuk Pengukuran</run></formatted-text><zone-style><format attr='border-color' value='None' /><format attr='border-style' value='none' /><format attr='border-width' value='0' /><format attr='margin' value='0' /><format attr='padding' value='4' /></zone-style></zone><zone h='11482' id='13' type-v2='text' w='96000' x='2000' y='3967'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Satuan</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>µg/m³</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Mikrogram polutan per meter kubik udara. Seluruh konsentrasi polutan (PM2.5, PM10, SO₂, CO, O₃, NO₂) dinyatakan dalam satuan ini.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Hari-Stasiun</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Satu stasiun pada satu hari. Contoh: 2 stasiun × 3 hari = 6 hari-stasiun.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Kelengkapan Data (%)</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Jumlah jam dengan data valid dibagi jumlah seluruh jam pada periode tersebut, dikali 100.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Musim</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Musim hujan November–April, musim kemarau Mei–Oktober, dan puncak kabut asap Agustus–Oktober.</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='6889' id='14' type-v2='text' w='96000' x='2000' y='16284'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Konversi Satuan</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Rumus</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>µg/m³ = ppm × M × 1000 ÷ 24,45, pada suhu 25 °C dan tekanan 1 atm. Digunakan untuk stasiun yang mencatat dalam ppm (BJB-01, MDN-01, PSW-01).</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>M</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Massa molar. Gas memakai massa molekulnya (ppm volume). PM tidak memiliki massa molekul, sehingga dibaca sebagai fraksi massa terhadap udara kering (M = 28,97).</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='13779' id='15' type-v2='text' w='96000' x='2000' y='24008'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Pengolahan Data</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Per Jam</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Data 15 menit dirata-ratakan menjadi data per jam apabila minimal 3 dari 4 nilai valid.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Harian</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Nilai harian dihitung apabila minimal 18 dari 24 jam valid.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Rata-Rata Stasiun</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Jumlah nilai jam valid ÷ jumlah jam valid pada filter aktif (minimal 10 hari).</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>CO dan O₃ 8 Jam</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Rata-rata bergerak 8 jam (minimal 6 jam valid), lalu diambil nilai maksimum hariannya.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Tanpa Data Pengganti</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Jam atau hari tanpa data dibiarkan kosong, tidak diisi dengan perkiraan, dan tidak diambil dari stasiun lain.</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='11482' id='16' type-v2='text' w='96000' x='2000' y='38622'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Indeks Kualitas Udara</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>ISPU Harian</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Permen LHK 14/2020. Batas PM2.5 24 jam: Baik 0–15,5, Sedang 15,5–55,4, Tidak Sehat 55,4–150,4, Sangat Tidak Sehat 150,4–250,4, Berbahaya &gt;250,4 µg/m³.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>IKU</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Permen LHK 27/2021, dari rata-rata tahunan NO₂ dan SO₂: Ieu = ((NO₂ ÷ 40) + (SO₂ ÷ 20)) ÷ 2, IKU = 100 − (50 ÷ 0,9) × (Ieu − 0,1), dibatasi 0–100.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Baku Mutu Tahunan</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>PP 22/2021: PM2.5 15, PM10 40, SO₂ 45, NO₂ 50, O₃ 35 µg/m³. Pedoman WHO 2021: PM2.5 5, PM10 15, NO₂ 10 µg/m³.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Baku Mutu 24 Jam</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>PM2.5 55, PM10 75, SO₂ 75, NO₂ 65 µg/m³.</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='11482' id='17' type-v2='text' w='96000' x='2000' y='50939'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Waktu dan Wilayah Kritis</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Episode Kabut Asap</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Minimal 3 hari berturut-turut dengan PM2.5 harian &gt;55,4 µg/m³ dan &gt;2× median PM2.5 musim hujan stasiun itu.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Pola per Jam</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Rata-rata tiap jam (WIB) pada hari tanpa kabut asap.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Skor Wilayah Kritis</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>0–100: rata-rata peringkat persentil dari PM2.5 rata-rata, % hari di atas baku mutu 24 jam, persentil ke-98 PM2.5 harian, dan jumlah hari ISPU Tidak Sehat ke atas.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Tren 2024 ke 2026</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Rata-rata 1 Januari–14 Oktober tiap tahun. Naik lebih dari 10% berarti memburuk, turun lebih dari 10% berarti membaik, selain itu stabil.</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='9186' id='18' type-v2='text' w='96000' x='2000' y='63257'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Faktor Penyebab</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Spearman ρ</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Kekuatan hubungan berbasis peringkat, bernilai −1 sampai 1. Antarstasiun memakai rata-rata musim hujan.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>R² dan Kepentingan Faktor</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>R² = porsi variasi PM2.5 harian yang dijelaskan model Random Forest (data latih 2024–2025, data uji 2026). Kepentingan = penurunan R² ketika faktor itu diacak.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Arah Angin</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>PM2.5 saat angin bertiup dari sektor terkotor dibandingkan dengan sektor terbersih (8 arah). Dianggap berpengaruh bila selisihnya ≥10%.</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='13779' id='19' type-v2='text' w='96000' x='2000' y='73278'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Dampak Kesehatan</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>% per +10 µg/m³</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Kenaikan kasus harian bila PM2.5 naik 10 µg/m³, dari model quasi-Poisson dengan kontrol tren waktu, suhu, kelembapan, hari, dan rumah sakit.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Hari Jeda</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Jeda hari setelah paparan. Jeda 0 berarti hari yang sama. Jeda 0–7 dimodelkan bersama.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Risiko Relatif (RR)</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Perbandingan jumlah kasus terhadap hari berkategori Baik (rata-rata PM2.5 3 hari).</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Kasus Akibat PM2.5</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Jumlah kasus × (1 − 1 ÷ RR kategori hari itu).</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Uji Beda (z)</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Membandingkan balita dengan lansia. Nilai |z| ≥1,96 berarti berbeda bermakna (taraf 5%).</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='9186' id='20' type-v2='text' w='96000' x='2000' y='87891'><formatted-text><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='14'>Jaringan Pemantauan</run><run>Æ&#10;</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Celah</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Jarak garis lurus (km) antarstasiun bertetangga pada jaringan terpendek dalam satu pulau. Celah ≥300 km ditandai merah.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Keandalan Alat</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Kritis: rusak atau kelengkapan &lt;50%. Buruk: kelengkapan &lt;75% atau sensor macet. Perlu standardisasi: beroperasi tidak menentu atau perlu konversi satuan. Selain itu: Baik.</run><run>Æ&#10;</run><run bold='true' fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Skor Prioritas</run><run>Æ&#10;</run><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='11'>Rata-rata berbobot: polusi 25%, kabut asap 20%, beban kesehatan 20%, defisit data 20%, keterisolasian 15%. Komponen kosong tidak diisi, bobotnya dibagi ulang.</run></formatted-text><zone-style><format attr='border-color' value='#e7e9ee' /><format attr='border-style' value='solid' /><format attr='border-width' value='1' /><format attr='margin' value='0' /><format attr='padding' value='14' /><format attr='background-color' value='#ffffff' /></zone-style></zone><zone h='1461' id='21' type-v2='text' w='96000' x='2000' y='97912'><formatted-text><run fontcolor='#000000' fontname='Helvetica Neue' fontsize='9' fontalignment='1'>Econs UGM Coba-Coba, 2026.</run></formatted-text><zone-style><format attr='border-color' value='None' /><format attr='border-style' value='none' /><format attr='border-width' value='0' /><format attr='margin' value='0' /><format attr='padding' value='4' /></zone-style></zone></zones><simple-id uuid='{7E9E24B4-458F-42CA-81B8-E82779C17773}' /></dashboard></dashboards><windows source-height='30'><window class='dashboard' maximized='true' name='Ringkasan'><viewpoints><viewpoint name='KPI Rata-Rata PM2.5'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Hari Tidak Sehat'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Hari Kabut Asap'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Kasus ISPA Balita'><zoom type='entire-view' /></viewpoint><viewpoint name='Peta PM2.5'><zoom type='entire-view' /></viewpoint><viewpoint name='PM2.5 per Pulau'><zoom type='entire-view' /></viewpoint><viewpoint name='Kategori ISPU per Pulau'><zoom type='entire-view' /></viewpoint></viewpoints><active id='-1' /><simple-id uuid='{BA0E9E80-785D-4605-99B4-5D29C1054EE3}' /></window><window class='dashboard' maximized='false' name='Kondisi'><viewpoints><viewpoint name='KPI Melampaui Baku Mutu'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Pulau Paling Tercemar'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Stasiun Memburuk'><zoom type='entire-view' /></viewpoint><viewpoint name='KPI Rata-Rata Polutan'><zoom type='entire-view' /></viewpoint><viewpoint name='Peringkat Stasiun'><zoom type='entire-view' /></viewpoint><viewpoint name='Kategori ISPU per Stasiun'><zoom type='entire-view' /></viewpoint><viewpoint name='Tren Bulanan'><zoom type='entire-view' /></viewpoint><viewpoint name='Baku Mutu dan IKU'><zoom type='entire-view' /></viewpoint><viewpoint name='Perbandingan 2024–2026'><zoom type='entire-view' /></viewpoint></viewpoints><active id='-1' /><simple-id uuid='{AE71A5D5-BB6C-486F-B3ED-D9FA7A85FEB5}' /></window><window class='dashboard' maximized='false' name='Waktu Kritis'><viewpoints><viewpoint name='KPI Episode Kabut Asap'><zoom type='entire-view' /></viewpoint><view