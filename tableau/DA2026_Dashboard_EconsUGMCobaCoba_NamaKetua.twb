tas' datatype='boolean' name='[Calculation_ll001]' role='dimension' type='nominal'><calculation class='tableau' formula='([Parameters].[p_pulau] = &quot;Semua pulau&quot; OR [pulau] = [Parameters].[p_pulau]) AND ([Parameters].[p_tipe] = &quot;Semua tipe lokasi&quot; OR [tipe_lokasi] = [Parameters].[p_tipe])' /></column><column caption='Polutan Lalu Lintas' datatype='real' default-format='n#,##0.0' name='[Calculation_ll002]' role='measure' type='quantitative'><calculation class='tableau' formula='CASE [Parameters].[p_lalin] WHEN &quot;PM2.5&quot; THEN [pm25] WHEN &quot;PM10&quot; THEN [pm10] WHEN &quot;NO₂&quot; THEN [no2] WHEN &quot;CO&quot; THEN [co] END' /></column></datasource><datasource caption='Arah Angin' inline='true' name='federated.aa' version='18.1'><connection class='federated'><named-connections><named-connection caption='Arah Angin' name='hyper.aa'><connection authentication='auth-none' author-locale='en_US' class='hyper' dbname='Data/Extracts/arah_angin.hyper' default-settings='yes' port='' sslmode='' username='tableau_internal_user' /></named-connection></named-connections><relation connection='hyper.aa' name='Extract' table='[Extract].[Extract]' type='table' /></connection><aliases enabled='yes' /><column caption='Stasiun' datatype='string' name='[stasiun]' role='dimension' type='nominal' /><column datatype='string' name='[dirtiest_sector]' role='dimension' type='nominal' /><column datatype='real' name='[dirtiest_pm25]' role='measure' type='quantitative' /><column datatype='string' name='[cleanest_sector]' role='dimension' type='nominal' /><column datatype='real' name='[cleanest_pm25]' role='measure' type='quantitative' /><column datatype='real' name='[sector_ratio]' role='measure' type='quantitative' /><column caption='Tipe Lokasi' datatype='string' name='[tipe_lokasi]' role='dimension' type='nominal' /><column caption='Pulau' datatype='string' name='[pulau]' role='dimension' type='nominal' /><column caption='Selisih PM2.5 (%)' datatype='real' defa